{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compila (MSVC)",
            "type": "shell",
            "command": ".\\build_vscode.bat",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Avvia server",
            "type": "shell",
            "command": ".\\server.exe 5000",
            "dependsOn": "Compila (MSVC)",
            "problemMatcher": []
        },
        {
            "label": "Avvia client",
            "type": "shell",
            "command": ".\\client.exe ${input:ip} 5000 \"${input:file}\"",
            // "dependsOn": "Compila (MSVC)",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "inputs": [
        {
            "id": "ip",
            "type": "promptString",
            "description": "IP del server",
            "default": "127.0.0.1"
        },
        {
            "id": "file",
            "type": "promptString",
            "description": "Percorso completo del file da inviare"
        }
    ]
}